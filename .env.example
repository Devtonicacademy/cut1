# ==========================================
# LIVELYBORG AI CONFIGURATION & API KEYS
# ==========================================

# 1. Google Gemini API Key (Required for AI Tactical Analysis)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Telegram VIP Alert Bot Token (Optional)
# Created via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 3. football-data.org key (Optional, free tier) - adds fixtures up to 14 days ahead for 8 top leagues
# Register at: https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=your_football_data_org_key_here

# 4. The Odds API key (Optional, free plan = 500 credits/month) - real market odds for fixtures
# football-data.co.uk has not priced yet. Get one at: https://the-odds-api.com
# Each refresh costs 1 credit per league with unpriced matches in the next ODDS_API_WINDOW_DAYS.
ODDS_API_KEY=your_the_odds_api_key_here
# ODDS_API_REGIONS=eu
# ODDS_API_REFRESH_HOURS=8
# ODDS_API_WINDOW_DAYS=3

# 5. Environment & Server Settings
PORT=8000
ENVIRONMENT=production
# Public domain for docker-compose / Caddy (automatic HTTPS), e.g. livelyborg.duckdns.org
SITE_ADDRESS=localhost
# Long random secret; enables admin endpoints (X-Admin-Token header). Leave empty to disable them.
ADMIN_TOKEN=
# Web origins allowed to call the API from a browser (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional: override the Gemini model name
# GEMINI_MODEL=gemini-3.8-flash

# 6. Web Frontend API URL
# In production, point this to your deployed API public URL (e.g. https://api.yourdomain.com/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
